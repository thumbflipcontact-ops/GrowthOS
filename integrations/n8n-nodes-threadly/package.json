{
  "name": "n8n-nodes-threadly",
  "version": "0.1.0",
  "description": "n8n community node for Threadly — find X/Twitter conversations and review AI-drafted replies from within an n8n workflow.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/thumbflipcontact-ops/GrowthOS/tree/main/integrations/n8n-nodes-threadly",
  "author": {
    "name": "Threadly",
    "email": "amol.parikh@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thumbflipcontact-ops/GrowthOS.git",
    "directory": "integrations/n8n-nodes-threadly"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ThreadlyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Threadly/Threadly.node.js",
      "dist/nodes/ThreadlyTrigger/ThreadlyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.43.4",
    "@types/node": "^22.20.1",
    "eslint": "^9.29.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
