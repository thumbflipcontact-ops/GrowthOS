{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "pip install -e backend -e plugins/dummy -e plugins/reddit -e plugins/twitter -e plugins/linkedin"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && arq app.jobs.agent_runs.WorkerSettings",
    "inputs": [
      {
        "step": "install"
      }
    ]
  }
}
