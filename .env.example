# Copy to .env and fill in real values. Never commit .env itself.
# See docs/config/CONFIGURATION.md for the full explanation of every variable.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://growthos:growthos_dev@localhost:5432/growthos
POSTGRES_PASSWORD=growthos_dev
# Async engine connection pooling, per process — see docs/scalability/SCALABILITY.md's
# "Database connection budget" before raising these across multiple worker replicas.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Redis (Arq broker, cache, rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers — see docs/decisions/0004-llm-provider-abstraction.md ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY_PROVIDER=anthropic

# --- App secrets ---
SECRET_KEY=
CREDENTIAL_MASTER_KEY=   # envelope-encryption master key — see docs/security/SECURITY.md

# --- Environment ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Error tracking (optional) — see app/core/observability.py. Every process behaves
# identically whether this is set or not; leave blank to skip.
# SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000             # CORS allowlist — must match where the
                                                   # frontend actually runs; same-registrable-
                                                   # domain with the backend (see docs/deployment/DEPLOYMENT.md)

# --- OAuth2 plugin framework — see docs/auth/OAUTH2_ARCHITECTURE.md ---
OAUTH_CALLBACK_BASE_URL=http://localhost:8000     # must match the redirect_uri registered
                                                   # with every OAuth-capable plugin's provider
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/settings/plugins
# Per-plugin OAuth app-registration credentials, one pair per OAuth-capable plugin you
# actually install — not fixed Settings fields, since the plugin set is open-ended.
# plugins/reddit/ needs these (register an app at https://www.reddit.com/prefs/apps first —
# "script" or "web app" type, redirect_uri = {OAUTH_CALLBACK_BASE_URL}/api/v1/oauth/reddit/callback):
# REDDIT_OAUTH_CLIENT_ID=
# REDDIT_OAUTH_CLIENT_SECRET=
# plugins/twitter/ needs these (register an app at https://developer.x.com/ with OAuth 2.0
# enabled — confidential client — redirect_uri =
# {OAUTH_CALLBACK_BASE_URL}/api/v1/oauth/twitter/callback):
# TWITTER_OAUTH_CLIENT_ID=
# TWITTER_OAUTH_CLIENT_SECRET=
# plugins/linkedin/ needs these (register an app at https://www.linkedin.com/developers/ and
# request the "Share on LinkedIn" product — redirect_uri =
# {OAUTH_CALLBACK_BASE_URL}/api/v1/oauth/linkedin/callback):
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=

# --- Billing (Phase 4) — see docs/billing/BILLING_ARCHITECTURE.md. Polar, not Stripe: Stripe
# does not currently onboard solo-founder/individual accounts in India. Create a Polar
# account at https://polar.sh, an Organization there, and THREE subscription Products — one
# per tiered-pricing launch tier (see "Tiered launch pricing" in BILLING_ARCHITECTURE.md) —
# each with the same 7-day trial configured on it, before setting these.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=              # from the webhook endpoint you register in Polar,
#                                     # pointing at {OAUTH_CALLBACK_BASE_URL}/api/v1/billing/webhook
# POLAR_PRODUCT_ID=                  # standard tier — $29/month, unlimited capacity
# POLAR_PRODUCT_ID_TIER1=            # founding tier — $9/month, first 5 signups only
# POLAR_PRODUCT_ID_TIER2=            # early tier — $19/month, next 10 signups only
# POLAR_SERVER=sandbox               # "sandbox" (default) or "production" — sandbox is safe
#                                     # to leave set until you're actually ready to take real
#                                     # payments; a misconfigured deployment should never
#                                     # silently hit production billing.
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
BILLING_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
